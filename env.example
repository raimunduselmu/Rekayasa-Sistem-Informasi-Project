PORT=3000

# --- SQL Server (login SQL Authentication; lihat README untuk cara mengaktifkan) ---
DB_SERVER=localhost
DB_PORT=1433
# Isi bila memakai named instance, mis. SQLEXPRESS (kosongkan DB_PORT jika instance dipakai)
DB_INSTANCE=
DB_NAME=ICMS_DB
DB_USER=ADMIN
DB_PASSWORD="admin**123"
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Rate limit endpoint publik POST /loans (BR-23, ERR-RATE-01).
# Saat latihan naikkan (mis. 100); saat demo 429 turunkan (mis. 3) lalu restart server.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=60
TRUST_PROXY=false

# Swagger UI di /docs (matikan di produksi: false)
ENABLE_DOCS=true

# Nomor WA penanggung jawab penyewaan (belum diputuskan tim: ini contoh, ganti sebelum demo)
WA_PIC_NUMBER=6281234567890

# Kosongkan SMTP_HOST untuk mode simulasi (email dicetak ke konsol server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sarpras KMK UNS <no-reply@kmk-uns.local>"
