{
  "name": "icms-loan-api",
  "version": "1.1.0",
  "description": "Backend demo: Ajukan Peminjaman (POST /api/v1/loans) - FSD-2.10, ICMS KMK UNS. SQL Server + Swagger.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
 "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx apps/api/scripts/migrate.ts",
    "db:reset": "tsx apps/api/scripts/migrate.ts --reset",
    "demo": "tsx apps/api/scripts/demo.ts",
    "test": "tsx --test apps/api/tests/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mssql": "^11.0.1",
    "nodemailer": "^6.9.16",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-ui-express": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
